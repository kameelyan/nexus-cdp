# ─── Local development ───────────────────────────────────────────────────────

# Fingerprint.js Pro public API key (get one at dashboard.fingerprint.com)
NEXT_PUBLIC_FP_API_KEY=your_fingerprint_js_public_key

# Database (Docker Compose default)
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_cdp

# Redis (Docker Compose default)
REDIS_URL=redis://localhost:6379

# CDP API base URL used by all frontend apps
NEXT_PUBLIC_CDP_API_URL=http://localhost:4000

# Webhook HMAC signing secret (min 32 chars)
WEBHOOK_SIGNING_SECRET=change_me_to_a_random_32_char_secret

# ─── Railway deployment ───────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL and REDIS_URL when you add the plugins.
# The variables below must be set manually in each Railway service.
#
# All 4 Next.js apps (platform, storefront, loyalty, telemetry-sim):
#   NEXT_PUBLIC_CDP_API_URL  = https://<your-api-service>.up.railway.app
#   NEXT_PUBLIC_FP_API_KEY   = your_fingerprint_js_public_key
#
# API service:
#   DATABASE_URL             ← auto-injected
#   REDIS_URL                ← auto-injected
#
# signal-engine + webhook-dispatcher:
#   DATABASE_URL             ← auto-injected
#   REDIS_URL                ← auto-injected
#   WEBHOOK_SIGNING_SECRET   = same value as API service
